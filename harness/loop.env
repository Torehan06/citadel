# Night-shift defaults, read by harness/loop.sh. Command-line flags override them.
# Lives under harness/, so agents can't change it. You can.

# Claude Code model chain, best first. When a session ends on a model-specific
# limit ("You've hit your Opus limit"), the loop continues on the next model
# instead of sleeping, then tries the first one again after STEP_UP_AFTER_MIN.
# Aliases (opus, sonnet, haiku, fable) follow whatever Claude Code currently maps
# them to, so new releases need no edit here. A full ID (claude-opus-5-5) pins one.
CLAUDE_MODELS=opus,sonnet

# Reasoning effort (claude --effort): low, medium, high, xhigh, max.
# Empty = the model's own default (Opus 5.5: medium). Higher effort burns more usage.
CLAUDE_EFFORT=

# Model for subagents a session spawns (CLAUDE_CODE_SUBAGENT_MODEL).
# Empty = same model as the session. Subagents mostly search and read.
CLAUDE_SUBAGENT_MODEL=sonnet

# Codex CLI model chain (empty = Codex's default model).
CODEX_MODELS=

STEP_UP_AFTER_MIN=300     # after dropping down the chain, retry the top model this much later
MAX_ITERS=8               # sessions per night
MAX_TURNS=60              # agent turns per session
SESSION_MINUTES=50        # wall-clock cap per session
