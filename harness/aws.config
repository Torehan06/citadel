# AWS CLI / SDK config used by the harness and by agents.
# harness/lib.sh points AWS_CONFIG_FILE here, so nothing in this repo can
# accidentally read your real ~/.aws and talk to real AWS.

[default]
region = tuchanka-1
endpoint_url = http://127.0.0.1:8420
output = json

[profile citadel]
region = tuchanka-1
endpoint_url = http://127.0.0.1:8420
output = json
